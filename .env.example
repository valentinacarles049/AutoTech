# AutoTech S.A. - Configuración de Servidor Node y Base de Datos (Supabase / PostgreSQL)
PORT=4000
# HOST=0.0.0.0
# CORS_ORIGIN=http://localhost:3000,http://localhost:4173

# Credenciales reales de Supabase (si se dejan vacías o de ejemplo, inicia en modo local en memoria)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Opcional: URL explícita de API cuando frontend y backend se despliegan en orígenes distintos
# VITE_API_URL=http://localhost:4000
